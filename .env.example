# Variabel lingkungan aplikasi Flask (modul PD dan MDIK).
# Aplikasi tidak memuat berkas .env secara otomatis; ekspor dulu di shell:
#   set -a; . ./.env; set +a

# Kunci sesi Flask. Kalau dibiarkan kosong, aplikasi membuat kunci acak per
# proses, sehingga sesi login hilang setiap server dijalankan ulang.
MDIK_SECRET_KEY=ganti-dengan-string-acak-yang-panjang

# Lokasi basis data SQLite MDIK. Kosong = 04_app/instance/mdik.sqlite3
MDIK_DB_PATH=

# Kata sandi akun demo. Ganti sebelum dipakai di luar komputer sendiri.
MDIK_ADMIN_PASSWORD=admin123
MDIK_OPERATOR_PASSWORD=operator123
MDIK_ANALIS_PASSWORD=analis123
